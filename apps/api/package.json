{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "provisionar:admin": "node dist/commands/provisionar-administrador.js",
    "seed:geral": "node dist/commands/seed-geral.js",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@repo/contracts": "workspace:*",
    "@repo/database": "workspace:*",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "nestjs-zod": "^5.6.0",
    "nodemailer": "10.6.1",
    "pdfkit": "0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@repo/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.2",
    "typescript": "^6.0.3",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*(\\.spec|\\.e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts"
    ],
    "coverageDirectory": "coverage",
    "setupFiles": [
      "<rootDir>/test/setup-environment.ts"
    ],
    "testEnvironment": "node"
  }
}
