# Homologação (staging)
APP_ENV=staging
NODE_ENV=production
APP_NAME=sipat
APP_VERSION=0.1.0
LOG_LEVEL=debug

WEB_PORT=3000
API_PORT=3001
WEB_PUBLISHED_PORT=3100
API_PUBLISHED_PORT=3101
MOBILE_WEB_PUBLISHED_PORT=3181
BIND_ADDRESS=127.0.0.1
WEB_URL=http://localhost:3100
MOBILE_WEB_URL=http://localhost:3181
API_INTERNAL_URL=http://api:3001
CORS_ORIGINS=http://localhost:3100,http://localhost:3181
AUTH_RATE_LIMIT_HMAC_SECRET=<gere-32-bytes-em-base64url-sem-padding>
AUTH_ARGON2_MAX_CONCURRENCY=4
AUTH_ARGON2_MAX_QUEUE=20
NEXT_PUBLIC_APP_NAME=SIPAT
NEXT_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_APP_NAME=SIPAT
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_API_URL=http://localhost:3101
EXPO_PUBLIC_API_PORT=3001

POSTGRES_USER=sipat_staging
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=sipat_staging
DATABASE_URL=postgresql://sipat_staging:replace-with-a-strong-password@db:5432/sipat_staging?schema=public

COMPOSE_PROJECT_NAME=sipat-staging
IMAGE_TAG=staging
