# Homologação (staging)
APP_ENV=staging
NODE_ENV=production
APP_NAME=project-starter
APP_VERSION=0.1.0
LOG_LEVEL=debug

WEB_PORT=3000
API_PORT=3001
WEB_PUBLISHED_PORT=3100
API_PUBLISHED_PORT=3101
BIND_ADDRESS=127.0.0.1
WEB_URL=http://localhost:3100
API_INTERNAL_URL=http://api:3001
CORS_ORIGINS=http://localhost:3100
NEXT_PUBLIC_APP_NAME=Project Starter
NEXT_PUBLIC_APP_ENV=staging

POSTGRES_USER=app_staging
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=app_staging
DATABASE_URL=postgresql://app_staging:replace-with-a-strong-password@db:5432/app_staging?schema=public

COMPOSE_PROJECT_NAME=project-starter-staging
IMAGE_TAG=staging
