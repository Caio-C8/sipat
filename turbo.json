{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "APP_ENV",
    "APP_NAME",
    "APP_VERSION",
    "API_PORT",
    "UPLOADS_ROOT_PATH",
    "WEB_PORT",
    "API_INTERNAL_URL",
    "CORS_ORIGINS",
    "AUTH_RATE_LIMIT_HMAC_SECRET",
    "AUTH_ARGON2_MAX_CONCURRENCY",
    "AUTH_ARGON2_MAX_QUEUE",
    "AUTH_PASSWORD_RESET_ENABLED",
    "AUTH_PASSWORD_RESET_URL",
    "AUTH_EMAIL_MAX_CONCURRENCY",
    "AUTH_EMAIL_MAX_QUEUE",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_REQUIRE_TLS",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_FROM",
    "DATABASE_URL",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_APP_ENV",
    "EXPO_PUBLIC_APP_NAME",
    "EXPO_PUBLIC_APP_ENV",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_API_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "db:generate": {
      "cache": false
    }
  }
}
