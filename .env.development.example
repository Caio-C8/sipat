# Identidade e ambiente
APP_ENV=development # Ambiente de execução 
NODE_ENV=development # Ambiente de execução técnico do node/framework (development)
APP_NAME=sipat
APP_VERSION=0.1.0
LOG_LEVEL=debug

# Aplicações locais
WEB_PORT=3000 # Porta web interna do container
API_PORT=3001 # Porta api interna do container
UPLOADS_HOST_PATH=./data/uploads # Diretório persistente do host montado pela API
UPLOADS_ROOT_PATH=C:/caminho/absoluto/para/sipat/data/uploads # Usado somente ao executar a API diretamente fora do Docker
WEB_PUBLISHED_PORT=3000 # Porta liberada na máquina host
API_PUBLISHED_PORT=3001 # Porta liberada na máquina host
DATABASE_PUBLISHED_PORT=5432 # Porta liberada na máquina host
BIND_ADDRESS=127.0.0.1 # IP onde as portas são expostas
WEB_URL=http://localhost:3000 # Documenta url web pública
API_INTERNAL_URL=http://localhost:3001 # URL usada pelo web para comunicação com a API dentro da rede docker
CORS_ORIGINS=http://localhost:3000,http://localhost:8081 # Origens permitidas pelo CORS da API
AUTH_RATE_LIMIT_HMAC_SECRET=<gere-32-bytes-em-base64url-sem-padding> # Hash para trasformar e-mails em chaves HMAC e armazenar o rate limit, gere o hash e substitue
AUTH_ARGON2_MAX_CONCURRENCY=2 # Define quantos logins podem ser executados simultâneamente em cada processo da API, valores de 1 a 32
AUTH_ARGON2_MAX_QUEUE=10 # Define quantas requisicoes adicionais podem aguardar uma vaga em cada processo, valores de 0 a 1000
AUTH_PASSWORD_RESET_ENABLED=true # Liga ou desliga completamente a recuperação de senha. false: esqueceu-senha responde 202, mas não cria token nem envia e-mail. true: habilita criação do token, SMTP e redefinição.
AUTH_PASSWORD_RESET_URL=http://localhost:3000/redefinir-senha # Página local que receberá o token; HTTP é aceito apenas em development e somente para localhost ou loopback.
AUTH_EMAIL_MAX_CONCURRENCY=2 # Quantidade máxima de e-mails enviados simultaneamente por processo da API.
AUTH_EMAIL_MAX_QUEUE=100 # Quantidade máxima de e-mails aguardando na fila em memória.
SMTP_HOST=smtp.gmail.com # Endereço do servidor responsável pelo envio SMTP.
SMTP_PORT=587 # Porta do servidor SMTP. Gmail: 587 para STARTTLS ou 465 para TLS desde o início.
SMTP_SECURE=false # true: inicia a conexão já protegida por TLS, normalmente na porta 465. false: começa a conexão normalmente e depois faz upgrade com STARTTLS.
SMTP_REQUIRE_TLS=true # Obriga o servidor a aceitar o upgrade STARTTLS. Na porta 587 deve ficar true.
SMTP_USER=email@gmail.com # Usuário usado para autenticar no servidor SMTP.
SMTP_PASSWORD="senha-de-app" # Credencial SMTP. Para Gmail, deve ser uma senha de app, e não a senha normal da conta.
SMTP_FROM="SIPAT <email@gmail.com>" # Endereço exibido como remetente. Com Gmail pessoal, mantenha o mesmo endereço usado em SMTP_USER.
NEXT_PUBLIC_APP_NAME=SIPAT # Variável pública no Next.js
NEXT_PUBLIC_APP_ENV=development # Variável pública no next
EXPO_PUBLIC_APP_NAME=SIPAT # Nome público exibido no aplicativo mobile
EXPO_PUBLIC_APP_ENV=development # Ambiente público do aplicativo mobile
EXPO_PUBLIC_API_URL=http://localhost:3001 # Opcional em desenvolvimento; o Expo usa o host do Metro quando vazio
EXPO_PUBLIC_API_PORT=3001 # Porta da API usada pelo aplicativo mobile

# Credenciais do Banco PostgreSQL
POSTGRES_USER=sipat
POSTGRES_PASSWORD=sipat
POSTGRES_DB=sipat
DATABASE_URL=postgresql://sipat:sipat@localhost:5432/sipat?schema=public

# Docker
COMPOSE_PROJECT_NAME=sipat-development # Nome do projeto
IMAGE_TAG=development # Tag das images docker, sendo o ambiente de execução
