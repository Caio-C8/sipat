generator client {
  provider        = "prisma-client-js"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum PerfilUsuario {
  ADMINISTRADOR
  DIRETOR_PATRIMONIO
}

enum TipoMembroComissao {
  PRESIDENTE
  MEMBRO
}

enum TipoIncorporacao {
  AQUISICAO
  DOACAO
  TRANSFERENCIA
  CESSAO
  COMODATO
  PERMUTA
  PRODUCAO_INTERNA
  OUTROS
}

enum StatusPatrimonio {
  ATIVO
  BAIXADO
  EMPRESTADO
  EM_MANUTENCAO
}

enum TipoNumeroPatrimonial {
  OFICIAL
  SEM_NUMERO_OFICIAL
}

enum TipoBaixa {
  ALIENACAO
  INUTILIZACAO
  SINISTRO
  FURTO
  EXTRAVIO
  TRANSFERENCIA
  RECLASSIFICACAO
  ABANDONO
  ERRO_REGISTRO
  OUTRO
}

enum TipoManutencao {
  PREVENTIVA
  CORRETIVA
}

enum StatusManutencao {
  EM_ANDAMENTO
  CONCLUIDA
}

enum FaseDocumentoManutencao {
  PEDIDO
  ENVIO
  RECEBIMENTO
  LEGADO
}

enum StatusInventario {
  FINALIZADO
  PENDENTE
  EM_ANDAMENTO
}

enum StatusSetorInventario {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
}

enum SituacaoItemInventario {
  DIVERGENCIA
  CORRETO
  NAO_LOCALIZADO
}

enum StatusVerificacaoItemInventario {
  VERIFICADO
  PENDENTE
}

enum StatusCorrecaoItemInventario {
  CORRIGIDO
  PENDENTE
}

enum TipoCorrecaoItemInventario {
  TRANSFERENCIA_CADASTRAL
  RETORNO_AO_SETOR_CADASTRADO
}

enum MetodoDepreciacao {
  LINEAR
}

enum TipoSessaoUsuario {
  WEB
  MOBILE
}

model Usuario {
  id                    String        @id @default(uuid()) @db.Uuid
  nome                  String        @db.VarChar(100)
  email                 String        @unique @db.VarChar(150)
  senha                 String        @db.VarChar(255)
  perfil                PerfilUsuario
  ativo                 Boolean       @default(true)
  trocaSenhaObrigatoria Boolean       @default(true) @map("troca_senha_obrigatoria")

  ultimoLoginAt DateTime? @map("ultimo_login_at") @db.Timestamp(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(6)
  createdById   String?   @map("created_by_id") @db.Uuid

  createdBy                             Usuario?                        @relation("UsuarioCriadoPor", fields: [createdById], references: [id])
  usuariosCriados                       Usuario[]                       @relation("UsuarioCriadoPor")
  responsaveisCriados                   Responsavel[]
  naturezasCriadas                      Natureza[]
  especiesCriadas                       Especie[]
  processosCompraCriados                ProcessoCompra[]
  setoresCriados                        Setor[]
  manutencoesCriadas                    Manutencao[]
  transferenciasCriadas                 TransferenciaPatrimonio[]
  fornecedoresCriados                   Fornecedor[]
  comissoesCriadas                      Comissao[]
  emprestimosCriados                    EmprestimoPatrimonio[]
  inventariosCriados                    Inventario[]
  inventariosIniciados                  Inventario[]                    @relation("InventarioIniciadoPor")
  inventariosFinalizados                Inventario[]                    @relation("InventarioFinalizadoPor")
  setoresInventarioIniciados            SetorInventario[]               @relation("SetorInventarioIniciadoPor")
  setoresInventarioConcluidos           SetorInventario[]               @relation("SetorInventarioConcluidoPor")
  itensInventarioVerificados            ItemInventario[]                @relation("ItemInventarioVerificadoPor")
  itensInventarioCorrigidos             ItemInventario[]                @relation("ItemInventarioCorrigidoPor")
  baixasCriadas                         BaixaPatrimonio[]
  patrimoniosCriados                    Patrimonio[]
  substituicoesNumeroPatrimonialCriadas SubstituicaoNumeroPatrimonial[]
  depreciacoesCriadas                   DepreciacaoPatrimonio[]
  reavaliacoesCriadas                   ReavaliacaoPatrimonio[]
  notasFiscaisCriadas                   NotaFiscal[]
  sessoes                               SessaoUsuario[]
  redefinicaoSenha                      RedefinicaoSenha?
  idempotenciasMovimentacao             IdempotenciaMovimentacao[]
  idempotenciasReavaliacao              IdempotenciaReavaliacao[]
  itensManutencaoRecebidos              ItemManutencao[]               @relation("ItemManutencaoRecebidoPor")
  revisoesOrcamentoManutencao            RevisaoOrcamentoManutencao[]
  documentosManutencao                   DocumentoManutencao[]
  idempotenciasManutencao                IdempotenciaManutencao[]

  @@map("usuarios")
}

model SessaoUsuario {
  id                String            @id @default(uuid()) @db.Uuid
  tokenHash         String            @unique @map("token_hash") @db.Char(64)
  expiraAt          DateTime          @map("expira_at") @db.Timestamp(6)
  accessExpiraAt    DateTime?         @map("access_expira_at") @db.Timestamp(6)
  ultimaAtividadeAt DateTime          @default(now()) @map("ultima_atividade_at") @db.Timestamp(6)
  revogadoAt        DateTime?         @map("revogado_at") @db.Timestamp(6)
  tipo              TipoSessaoUsuario @default(WEB)
  usuarioId         String            @map("usuario_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  usuario       Usuario               @relation(fields: [usuarioId], references: [id])
  refreshTokens SessaoMobileRefresh[]

  @@index([usuarioId, revogadoAt], map: "sessoes_usuarios_usuario_id_revogado_at_idx")
  @@map("sessoes_usuarios")
}

model SessaoMobileRefresh {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiraAt  DateTime  @map("expira_at") @db.Timestamp(6)
  usadoAt   DateTime? @map("usado_at") @db.Timestamp(6)
  sessaoId  String    @map("sessao_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  sessao SessaoUsuario @relation(fields: [sessaoId], references: [id])

  @@index([sessaoId, usadoAt], map: "sessoes_mobile_refresh_sessao_id_usado_at_idx")
  @@map("sessoes_mobile_refresh")
}

model TentativaLogin {
  chaveHash      String   @id @map("chave_hash") @db.Char(64)
  tentativas     Int
  janelaExpiraAt DateTime @map("janela_expira_at") @db.Timestamp(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([janelaExpiraAt], map: "tentativas_login_janela_expira_at_idx")
  @@map("tentativas_login")
}

model TentativaOperacaoSenha {
  chaveHash      String   @id @map("chave_hash") @db.Char(64)
  tentativas     Int
  janelaExpiraAt DateTime @map("janela_expira_at") @db.Timestamp(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([janelaExpiraAt], map: "tentativas_operacoes_senha_janela_expira_at_idx")
  @@map("tentativas_operacoes_senha")
}

model RedefinicaoSenha {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiraAt    DateTime  @map("expira_at") @db.Timestamp(6)
  consumidoAt DateTime? @map("consumido_at") @db.Timestamp(6)
  usuarioId   String    @unique @map("usuario_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiraAt], map: "redefinicoes_senha_expira_at_idx")
  @@map("redefinicoes_senha")
}

model Responsavel {
  id        String  @id @default(uuid()) @db.Uuid
  nome      String  @db.VarChar(100)
  matricula String  @unique @db.VarChar(20)
  ativo     Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)
  createdById String    @map("created_by_id") @db.Uuid

  createdBy       Usuario          @relation(fields: [createdById], references: [id])
  setores         Setor[]
  membrosComissao MembroComissao[]

  @@map("responsaveis")
}

model Natureza {
  id              String  @id @default(uuid()) @db.Uuid
  nome            String  @unique @db.VarChar(100)
  nomeNormalizado String  @unique @map("nome_normalizado") @db.VarChar(100)
  descricao       String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  createdById String    @map("created_by_id") @db.Uuid
  createdBy   Usuario   @relation(fields: [createdById], references: [id])
  especies    Especie[]

  @@map("naturezas")
}

model Especie {
  id              String  @id @default(uuid()) @db.Uuid
  nome            String  @db.VarChar(100)
  nomeNormalizado String  @unique @map("nome_normalizado") @db.VarChar(100)
  descricao       String? @db.Text
  naturezaId      String  @map("natureza_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)
  createdById String    @map("created_by_id") @db.Uuid

  natureza    Natureza     @relation(fields: [naturezaId], references: [id])
  createdBy   Usuario      @relation(fields: [createdById], references: [id])
  patrimonios Patrimonio[]

  @@map("especies")
}

model ProcessoCompra {
  id             String   @id @default(uuid()) @db.Uuid
  numeroProcesso String?  @map("numero_processo") @db.VarChar(50)
  anoProcesso    Int?     @map("ano_processo") @db.SmallInt
  numeroEmpenho  String?  @map("numero_empenho") @db.VarChar(50)
  anoEmpenho     Int?     @map("ano_empenho") @db.SmallInt
  valorTotal     Decimal? @map("valor_total") @db.Decimal(19, 7)
  observacao     String?  @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)
  createdById String    @map("created_by_id") @db.Uuid

  createdBy    Usuario      @relation(fields: [createdById], references: [id])
  notasFiscais NotaFiscal[]
  patrimonios  Patrimonio[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "processos_compra_created_at_id_idx")
  @@index([anoProcesso], map: "processos_compra_ano_processo_idx")
  @@index([anoEmpenho], map: "processos_compra_ano_empenho_idx")
  @@map("processos_compra")
}

model Setor {
  id            String  @id @default(uuid()) @db.Uuid
  nome          String  @db.VarChar(100)
  sala          String? @db.VarChar(50)
  ramal         String? @db.VarChar(10)
  responsavelId String  @map("responsavel_id") @db.Uuid
  ativo         Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)
  createdById String    @map("created_by_id") @db.Uuid

  responsavel                        Responsavel               @relation(fields: [responsavelId], references: [id])
  createdBy                          Usuario                   @relation(fields: [createdById], references: [id])
  patrimoniosAtuais                  Patrimonio[]
  transferenciasComoSetorAntigo      TransferenciaPatrimonio[] @relation("TransferenciaSetorAntigo")
  transferenciasComoSetorAtual       TransferenciaPatrimonio[] @relation("TransferenciaSetorAtual")
  itensInventarioComoSetorEsperado   ItemInventario[]          @relation("ItemInventarioSetorEsperado")
  itensInventarioComoSetorEncontrado ItemInventario[]          @relation("ItemInventarioSetorEncontrado")
  setoresInventario                  SetorInventario[]

  @@map("setores")
}

model Fornecedor {
  id                String  @id @default(uuid()) @db.Uuid
  razaoSocial       String  @map("razao_social") @db.VarChar(150)
  nomeFantasia      String? @map("nome_fantasia") @db.VarChar(150)
  nomeRepresentante String? @map("nome_representante") @db.VarChar(150)
  cnpj              String? @unique @db.VarChar(20)
  email             String? @db.VarChar(150)
  telefone          String? @db.VarChar(30)
  endereco          String? @db.Text
  ativo             Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)
  createdById String    @map("created_by_id") @db.Uuid

  createdBy    Usuario      @relation(fields: [createdById], references: [id])
  notasFiscais NotaFiscal[]
  manutencoes  Manutencao[]
  itensManutencao ItemManutencao[]
  revisoesOrcamentoManutencao RevisaoOrcamentoManutencao[]

  @@map("fornecedores")
}

model Comissao {
  id                 String   @id @default(uuid()) @db.Uuid
  nome               String   @db.VarChar(150)
  descricao          String?  @db.Text
  numeroAto          String?  @map("numero_ato") @db.VarChar(100)
  dataVigenciaInicio DateTime @map("data_vigencia_inicio") @db.Date
  dataVigenciaFim    DateTime @map("data_vigencia_fim") @db.Date

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)
  createdById String    @map("created_by_id") @db.Uuid

  createdBy      Usuario                   @relation(fields: [createdById], references: [id])
  membros        MembroComissao[]
  transferencias TransferenciaPatrimonio[]
  emprestimos    EmprestimoPatrimonio[]
  manutencoes    Manutencao[]
  inventarios    Inventario[]
  baixas         BaixaPatrimonio[]
  devolucoes     DevolucaoPatrimonio[]
  depreciacoes   DepreciacaoPatrimonio[]
  reavaliacoes   ReavaliacaoPatrimonio[]

  @@index([createdAt, id], map: "comissoes_created_at_id_idx")
  @@map("comissoes")
}

model MembroComissao {
  id                 String             @id @default(uuid()) @db.Uuid
  tipoMembroComissao TipoMembroComissao @map("tipo_membro_comissao")
  comissaoId         String             @map("comissao_id") @db.Uuid
  responsavelId      String             @map("responsavel_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  comissao    Comissao    @relation(fields: [comissaoId], references: [id])
  responsavel Responsavel @relation(fields: [responsavelId], references: [id])

  @@unique([comissaoId, responsavelId])
  @@unique([comissaoId], map: "membros_comissao_presidente_unico_idx", where: { tipoMembroComissao: "PRESIDENTE" })
  @@map("membros_comissao")
}

model NotaFiscal {
  id                     String   @id @default(uuid()) @db.Uuid
  numeroNotaFiscal       String   @map("numero_nota_fiscal") @db.VarChar(50)
  anoNotaFiscal          Int      @map("ano_nota_fiscal") @db.SmallInt
  dataEmissao            DateTime @map("data_emissao") @db.Date
  caminhoAnexoNotaFiscal String?  @map("caminho_anexo_nota_fiscal") @db.VarChar(500)
  processoCompraId       String   @map("processo_compra_id") @db.Uuid
  fornecedorId           String   @map("fornecedor_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)
  createdById String    @map("created_by_id") @db.Uuid

  processoCompra ProcessoCompra @relation(fields: [processoCompraId], references: [id])
  fornecedor     Fornecedor     @relation(fields: [fornecedorId], references: [id])
  createdBy      Usuario        @relation(fields: [createdById], references: [id])

  @@index([processoCompraId, createdAt, id], map: "notas_fiscais_processo_compra_created_at_id_idx")
  @@index([fornecedorId, processoCompraId], map: "notas_fiscais_fornecedor_processo_compra_idx")
  @@map("notas_fiscais")
}

model Patrimonio {
  id                    String                @id @default(uuid()) @db.Uuid
  numeroPatrimonio      String                @unique @map("numero_patrimonio") @db.VarChar(50)
  tipoNumeroPatrimonial TipoNumeroPatrimonial @map("tipo_numero_patrimonial")
  descricao             String                @db.Text
  marca                 String?               @db.VarChar(100)
  modelo                String?               @db.VarChar(100)
  numeroSerie           String?               @unique @map("numero_serie") @db.VarChar(100)
  textoBusca            String?               @map("texto_busca") @db.Text
  tipoIncorporacao      TipoIncorporacao      @default(AQUISICAO) @map("tipo_incorporacao")
  dataTombamento        DateTime              @map("data_tombamento") @db.Date
  valorIncorporacao     Decimal               @map("valor_incorporacao") @db.Decimal(19, 7)
  status                StatusPatrimonio      @default(ATIVO)
  especieId             String                @map("especie_id") @db.Uuid
  setorAtualId          String                @map("setor_atual_id") @db.Uuid
  processoCompraId      String?               @map("processo_compra_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)
  createdById String    @map("created_by_id") @db.Uuid

  especie               Especie                         @relation(fields: [especieId], references: [id])
  setorAtual            Setor                           @relation(fields: [setorAtualId], references: [id])
  processoCompra        ProcessoCompra?                 @relation(fields: [processoCompraId], references: [id])
  createdBy             Usuario                         @relation(fields: [createdById], references: [id])
  situacaoContabil      SituacaoContabilPatrimonio?
  parametrosDepreciacao ParametroDepreciacao[]
  depreciacoes          DepreciacaoPatrimonio[]
  reavaliacoes          ReavaliacaoPatrimonio[]
  transferencias        TransferenciaPatrimonio[]
  emprestimos           EmprestimoPatrimonio[]
  itensManutencao       ItemManutencao[]
  itensInventario       ItemInventario[]
  baixas                BaixaPatrimonio[]
  substituicoesNumero   SubstituicaoNumeroPatrimonial[]

  @@map("patrimonios")
}

model SubstituicaoNumeroPatrimonial {
  id             String   @id @default(uuid()) @db.Uuid
  patrimonioId   String   @map("patrimonio_id") @db.Uuid
  numeroAnterior String   @map("numero_anterior") @db.VarChar(50)
  numeroNovo     String   @map("numero_novo") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdById    String   @map("created_by_id") @db.Uuid

  patrimonio Patrimonio @relation(fields: [patrimonioId], references: [id])
  createdBy  Usuario    @relation(fields: [createdById], references: [id])

  @@index([patrimonioId, createdAt], map: "substituicoes_numero_patrimonial_patrimonio_id_created_at_idx")
  @@map("substituicoes_numero_patrimonial")
}

model TransferenciaPatrimonio {
  id                String   @id @default(uuid()) @db.Uuid
  dataTransferencia DateTime @map("data_transferencia") @db.Timestamp(6)
  observacao        String?  @db.Text
  setorAntigoId     String   @map("setor_antigo_id") @db.Uuid
  setorAtualId      String   @map("setor_atual_id") @db.Uuid
  patrimonioId      String   @map("patrimonio_id") @db.Uuid
  comissaoId        String   @map("comissao_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdById String   @map("created_by_id") @db.Uuid

  setorAntigo            Setor           @relation("TransferenciaSetorAntigo", fields: [setorAntigoId], references: [id])
  setorAtual             Setor           @relation("TransferenciaSetorAtual", fields: [setorAtualId], references: [id])
  patrimonio             Patrimonio      @relation(fields: [patrimonioId], references: [id])
  comissao               Comissao        @relation(fields: [comissaoId], references: [id])
  createdBy              Usuario         @relation(fields: [createdById], references: [id])
  itemInventarioCorrecao ItemInventario?

  @@index([comissaoId], map: "transferencias_patrimoniais_comissao_id_idx")
  @@index([patrimonioId, dataTransferencia(sort: Desc), id(sort: Desc)], map: "transferencias_patrimonio_data_id_idx")
  @@index([dataTransferencia(sort: Desc), id(sort: Desc)], map: "transferencias_data_id_idx")
  @@index([setorAntigoId, dataTransferencia(sort: Desc), id(sort: Desc)], map: "transferencias_origem_data_id_idx")
  @@index([setorAtualId, dataTransferencia(sort: Desc), id(sort: Desc)], map: "transferencias_destino_data_id_idx")
  @@index([comissaoId, dataTransferencia(sort: Desc), id(sort: Desc)], map: "transferencias_comissao_data_id_idx")
  @@map("transferencias_patrimoniais")
}

model EmprestimoPatrimonio {
  id                    String    @id @default(uuid()) @db.Uuid
  dataEmprestimo        DateTime  @map("data_emprestimo") @db.Timestamp(6)
  dataPrevistaDevolucao DateTime? @map("data_prevista_devolucao") @db.Timestamp(6)
  destinatario          String?   @db.VarChar(200)
  finalidade            String?   @db.Text
  observacao            String?   @db.Text
  grupoEmprestimoId     String    @map("grupo_emprestimo_id") @db.Uuid
  comissaoId            String    @map("comissao_id") @db.Uuid
  patrimonioId          String    @map("patrimonio_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdById String   @map("created_by_id") @db.Uuid

  comissao                    Comissao             @relation(fields: [comissaoId], references: [id])
  patrimonio                  Patrimonio           @relation(fields: [patrimonioId], references: [id])
  createdBy                   Usuario              @relation(fields: [createdById], references: [id])
  devolucao                   DevolucaoPatrimonio?
  itensInventarioJustificados ItemInventario[]

  @@unique([id, patrimonioId], map: "emprestimos_patrimonio_id_patrimonio_id_key")
  @@index([comissaoId], map: "emprestimos_patrimoniais_comissao_id_idx")
  @@index([patrimonioId, dataEmprestimo(sort: Desc), id(sort: Desc)], map: "emprestimos_patrimonio_data_id_idx")
  @@map("emprestimos_patrimoniais")
}

model DevolucaoPatrimonio {
  id            String   @id @default(uuid()) @db.Uuid
  dataDevolucao DateTime @map("data_devolucao") @db.Timestamp(6)
  observacao    String?  @db.Text
  emprestimoId  String   @unique @map("emprestimo_id") @db.Uuid
  comissaoId    String   @map("comissao_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  emprestimo EmprestimoPatrimonio @relation(fields: [emprestimoId], references: [id])
  comissao   Comissao             @relation(fields: [comissaoId], references: [id])

  @@index([comissaoId], map: "devolucoes_patrimoniais_comissao_id_idx")
  @@map("devolucoes_patrimoniais")
}

model Manutencao {
  id                     String           @id @default(uuid()) @db.Uuid
  numeroRequisicao       String?          @map("numero_requisicao") @db.VarChar(50)
  numeroEmpenho          String?          @map("numero_empenho") @db.VarChar(50)
  anoEmpenho             Int?             @map("ano_empenho") @db.SmallInt
  tipo                   TipoManutencao?
  justificativa          String?          @db.Text
  dataEmpenho            DateTime?        @map("data_empenho") @db.Date
  dataEnvio              DateTime         @map("data_envio") @db.Date
  previsaoRetorno        DateTime?        @map("previsao_retorno") @db.Date
  dataRetorno            DateTime?        @map("data_retorno") @db.Date
  status                 StatusManutencao @default(EM_ANDAMENTO)
  observacao             String?          @db.Text
  caminhoAnexoObservacao String?          @map("caminho_anexo_observacao") @db.VarChar(500)
  fornecedorId           String?          @map("fornecedor_id") @db.Uuid
  comissaoId             String           @map("comissao_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)
  createdById String    @map("created_by_id") @db.Uuid

  fornecedor Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  comissao   Comissao         @relation(fields: [comissaoId], references: [id])
  createdBy  Usuario          @relation(fields: [createdById], references: [id])
  itens      ItemManutencao[]
  documentos DocumentoManutencao[]
  idempotencias IdempotenciaManutencao[]

  @@index([comissaoId], map: "manutencoes_comissao_id_idx")
  @@index([status, dataEnvio(sort: Desc), id(sort: Desc)], map: "manutencoes_status_envio_id_idx")
  @@index([dataEnvio(sort: Desc), id(sort: Desc)], map: "manutencoes_envio_id_idx")
  @@map("manutencoes")
}

model ItemManutencao {
  id                        String    @id @default(uuid()) @db.Uuid
  tipo                      TipoManutencao
  fornecedorId              String?   @map("fornecedor_id") @db.Uuid
  previsaoRetorno           DateTime? @map("previsao_retorno") @db.Date
  versaoOrcamento           Int       @default(0) @map("versao_orcamento")
  descricaoGarantia         String?   @map("descricao_garantia") @db.Text
  dataFimGarantia           DateTime? @map("data_fim_garantia") @db.Date
  recebidoPorId             String?   @map("recebido_por_id") @db.Uuid
  recebidoEm               DateTime? @map("recebido_em") @db.Timestamp(6)
  descricaoProblema         String?   @map("descricao_problema") @db.Text
  dataOrcamento             DateTime? @map("data_orcamento") @db.Date
  descricaoOrcamento        String?   @map("descricao_orcamento") @db.Text
  valorOrcamento            Decimal?  @map("valor_orcamento") @db.Decimal(19, 7)
  descricaoServicoRealizado String?   @map("descricao_servico_realizado") @db.Text
  valorRealizado            Decimal?  @map("valor_realizado") @db.Decimal(19, 7)
  dataRetorno               DateTime? @map("data_retorno") @db.Date
  observacao                String?   @db.Text
  caminhoAnexoObservacao    String?   @map("caminho_anexo_observacao") @db.VarChar(500)
  manutencaoId              String    @map("manutencao_id") @db.Uuid
  patrimonioId              String    @map("patrimonio_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  manutencao                  Manutencao       @relation(fields: [manutencaoId], references: [id])
  patrimonio                  Patrimonio       @relation(fields: [patrimonioId], references: [id])
  fornecedor                  Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  recebidoPor                 Usuario?         @relation("ItemManutencaoRecebidoPor", fields: [recebidoPorId], references: [id])
  revisoesOrcamento           RevisaoOrcamentoManutencao[]
  documentos                  DocumentoManutencao[]
  idempotencias               IdempotenciaManutencao[]
  itensInventarioJustificados ItemInventario[]

  @@unique([id, patrimonioId], map: "itens_manutencao_id_patrimonio_id_key")
  @@unique([manutencaoId, patrimonioId], map: "itens_manutencao_pedido_patrimonio_key")
  @@unique([patrimonioId], map: "itens_manutencao_abertos_patrimonio_key", where: { dataRetorno: null })
  @@index([patrimonioId, id], map: "itens_manutencao_patrimonio_id_idx")
  @@map("itens_manutencao")
}

model RevisaoOrcamentoManutencao {
  id                   String   @id @default(uuid()) @db.Uuid
  itemId               String   @map("item_id") @db.Uuid
  versao               Int
  dataOrcamento        DateTime @map("data_orcamento") @db.Date
  descricaoOrcamento   String   @map("descricao_orcamento") @db.Text
  valorOrcamento       Decimal  @map("valor_orcamento") @db.Decimal(19, 7)
  fornecedorId         String?  @map("fornecedor_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdById          String   @map("created_by_id") @db.Uuid

  item        ItemManutencao @relation(fields: [itemId], references: [id])
  fornecedor  Fornecedor?     @relation(fields: [fornecedorId], references: [id])
  createdBy   Usuario        @relation(fields: [createdById], references: [id])

  @@unique([itemId, versao], map: "revisoes_orcamento_item_versao_key")
  @@map("revisoes_orcamento_manutencao")
}

model DocumentoManutencao {
  id            String                   @id @default(uuid()) @db.Uuid
  manutencaoId  String                   @map("manutencao_id") @db.Uuid
  itemId        String?                  @map("item_id") @db.Uuid
  fase          FaseDocumentoManutencao
  chave         String                   @db.VarChar(500)
  nome          String                   @db.VarChar(255)
  tamanhoBytes  Int?                     @map("tamanho_bytes")
  hashSha256    String?                  @map("hash_sha256") @db.Char(64)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  createdById   String?                  @map("created_by_id") @db.Uuid

  manutencao  Manutencao     @relation(fields: [manutencaoId], references: [id])
  item        ItemManutencao? @relation(fields: [itemId], references: [id])
  createdBy   Usuario?       @relation(fields: [createdById], references: [id])

  @@index([manutencaoId, createdAt, id], map: "documentos_manutencao_pedido_data_idx")
  @@index([itemId, createdAt, id], map: "documentos_manutencao_item_data_idx")
  @@map("documentos_manutencao")
}

model IdempotenciaManutencao {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  chave         String   @db.Uuid
  tipo          String   @db.VarChar(20)
  hashPayload   String   @map("hash_payload") @db.Char(64)
  resultado     Json
  manutencaoId  String   @map("manutencao_id") @db.Uuid
  itemId        String?  @map("item_id") @db.Uuid
  documentoId   String?  @map("documento_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  usuario    Usuario      @relation(fields: [usuarioId], references: [id])
  manutencao Manutencao   @relation(fields: [manutencaoId], references: [id])
  item       ItemManutencao? @relation(fields: [itemId], references: [id])

  @@unique([usuarioId, chave], map: "idempotencias_manutencao_usuario_chave_key")
  @@map("idempotencias_manutencao")
}

model Inventario {
  id              String           @id @default(uuid()) @db.Uuid
  nome            String           @db.VarChar(150)
  descricao       String?          @db.Text
  dataInicio      DateTime?        @map("data_inicio") @db.Date
  dataFim         DateTime?        @map("data_fim") @db.Date
  status          StatusInventario @default(PENDENTE)
  observacao      String?          @db.Text
  comissaoId      String           @map("comissao_id") @db.Uuid
  iniciadoPorId   String?          @map("iniciado_por_id") @db.Uuid
  finalizadoPorId String?          @map("finalizado_por_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(6)
  createdById String    @map("created_by_id") @db.Uuid

  comissao      Comissao          @relation(fields: [comissaoId], references: [id])
  createdBy     Usuario           @relation(fields: [createdById], references: [id])
  iniciadoPor   Usuario?          @relation("InventarioIniciadoPor", fields: [iniciadoPorId], references: [id])
  finalizadoPor Usuario?          @relation("InventarioFinalizadoPor", fields: [finalizadoPorId], references: [id])
  setores       SetorInventario[]
  itens         ItemInventario[]

  @@index([comissaoId], map: "inventarios_comissao_id_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "inventarios_status_created_at_id_idx")
  @@map("inventarios")
}

model SetorInventario {
  id             String                @id @default(uuid()) @db.Uuid
  status         StatusSetorInventario @default(PENDENTE)
  dataInicio     DateTime?             @map("data_inicio") @db.Timestamp(6)
  dataFim        DateTime?             @map("data_fim") @db.Timestamp(6)
  inventarioId   String                @map("inventario_id") @db.Uuid
  setorId        String                @map("setor_id") @db.Uuid
  iniciadoPorId  String?               @map("iniciado_por_id") @db.Uuid
  concluidoPorId String?               @map("concluido_por_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  inventario   Inventario       @relation(fields: [inventarioId], references: [id])
  setor        Setor            @relation(fields: [setorId], references: [id])
  iniciadoPor  Usuario?         @relation("SetorInventarioIniciadoPor", fields: [iniciadoPorId], references: [id])
  concluidoPor Usuario?         @relation("SetorInventarioConcluidoPor", fields: [concluidoPorId], references: [id])
  itens        ItemInventario[]

  @@unique([inventarioId, setorId])
  @@unique([id, inventarioId, setorId], map: "setores_inventario_vinculo_item_key")
  @@unique([inventarioId], map: "setores_inventario_um_em_andamento_por_inventario_idx", where: { status: "EM_ANDAMENTO" })
  @@unique([setorId], map: "setores_inventario_setor_fisico_em_andamento_idx", where: { status: "EM_ANDAMENTO" })
  @@index([inventarioId, status, id], map: "setores_inventario_inventario_status_idx")
  @@index([setorId, inventarioId], map: "setores_inventario_setor_inventario_idx")
  @@map("setores_inventario")
}

model ItemInventario {
  id                            String                          @id @default(uuid()) @db.Uuid
  situacao                      SituacaoItemInventario?
  statusVerificacao             StatusVerificacaoItemInventario @default(PENDENTE) @map("status_verificacao")
  dataVerificacao               DateTime?                       @map("data_verificacao") @db.Timestamp(6)
  statusCorrecao                StatusCorrecaoItemInventario?   @map("status_correcao")
  tipoCorrecao                  TipoCorrecaoItemInventario?     @map("tipo_correcao")
  dataCorrecao                  DateTime?                       @map("data_correcao") @db.Timestamp(6)
  observacao                    String?                         @db.Text
  setorEsperadoId               String                          @map("setor_esperado_id") @db.Uuid
  setorEncontradoId             String?                         @map("setor_encontrado_id") @db.Uuid
  patrimonioId                  String                          @map("patrimonio_id") @db.Uuid
  setorInventarioId             String                          @map("setor_inventario_id") @db.Uuid
  inventarioId                  String                          @map("inventario_id") @db.Uuid
  transferenciaCorrecaoId       String?                         @unique @map("transferencia_correcao_id") @db.Uuid
  verificadoPorId               String?                         @map("verificado_por_id") @db.Uuid
  corrigidoPorId                String?                         @map("corrigido_por_id") @db.Uuid
  statusPatrimonioNaVerificacao StatusPatrimonio?               @map("status_patrimonio_na_verificacao")
  emprestimoPatrimonioId        String?                         @map("emprestimo_patrimonio_id") @db.Uuid
  itemManutencaoId              String?                         @map("item_manutencao_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  setorEsperado         Setor                    @relation("ItemInventarioSetorEsperado", fields: [setorEsperadoId], references: [id])
  setorEncontrado       Setor?                   @relation("ItemInventarioSetorEncontrado", fields: [setorEncontradoId], references: [id])
  patrimonio            Patrimonio               @relation(fields: [patrimonioId], references: [id])
  setorInventario       SetorInventario          @relation(fields: [setorInventarioId, inventarioId, setorEsperadoId], references: [id, inventarioId, setorId], map: "itens_inventario_setor_inventario_vinculo_fkey")
  inventario            Inventario               @relation(fields: [inventarioId], references: [id])
  transferenciaCorrecao TransferenciaPatrimonio? @relation(fields: [transferenciaCorrecaoId], references: [id])
  verificadoPor         Usuario?                 @relation("ItemInventarioVerificadoPor", fields: [verificadoPorId], references: [id])
  corrigidoPor          Usuario?                 @relation("ItemInventarioCorrigidoPor", fields: [corrigidoPorId], references: [id])
  emprestimoPatrimonio  EmprestimoPatrimonio?    @relation(fields: [emprestimoPatrimonioId, patrimonioId], references: [id, patrimonioId], map: "itens_inventario_emprestimo_patrimonio_fkey")
  itemManutencao        ItemManutencao?          @relation(fields: [itemManutencaoId, patrimonioId], references: [id, patrimonioId], map: "itens_inventario_item_manutencao_fkey")

  @@unique([inventarioId, patrimonioId])
  @@index([inventarioId, statusVerificacao, situacao, statusCorrecao], map: "itens_inventario_pendencias_idx")
  @@index([patrimonioId], map: "itens_inventario_patrimonio_id_idx")
  @@map("itens_inventario")
}

model BaixaPatrimonio {
  id                    String    @id @default(uuid()) @db.Uuid
  dataBaixa             DateTime  @map("data_baixa") @db.Date
  tipo                  TipoBaixa
  motivo                String    @db.Text
  observacao            String?   @db.Text
  caminhoAnexoDocumento String?   @map("caminho_anexo_documento") @db.VarChar(500)
  patrimonioId          String    @unique(map: "baixas_patrimoniais_patrimonio_id_key") @map("patrimonio_id") @db.Uuid
  comissaoId            String    @map("comissao_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdById String   @map("created_by_id") @db.Uuid

  patrimonio Patrimonio @relation(fields: [patrimonioId], references: [id])
  comissao   Comissao   @relation(fields: [comissaoId], references: [id])
  createdBy  Usuario    @relation(fields: [createdById], references: [id])

  @@index([comissaoId], map: "baixas_patrimoniais_comissao_id_idx")
  @@map("baixas_patrimoniais")
}

model SituacaoContabilPatrimonio {
  id                        String  @id @default(uuid()) @db.Uuid
  valorBrutoAtual           Decimal @map("valor_bruto_atual") @db.Decimal(19, 7)
  depreciacaoAcumuladaAtual Decimal @default(0) @map("depreciacao_acumulada_atual") @db.Decimal(19, 7)
  patrimonioId              String  @unique @map("patrimonio_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  patrimonio Patrimonio @relation(fields: [patrimonioId], references: [id])

  @@map("situacoes_contabeis_patrimoniais")
}

model ParametroDepreciacao {
  id                   String            @id @default(uuid()) @db.Uuid
  metodo               MetodoDepreciacao
  vidaUtilInicialMeses Int               @map("vida_util_inicial_meses")
  percentualResidual   Decimal?          @map("percentual_residual") @db.Decimal(5, 2)
  valorResidual        Decimal           @map("valor_residual") @db.Decimal(19, 7)
  valorBaseInicial     Decimal           @map("valor_base_inicial") @db.Decimal(19, 7)
  dataInicio           DateTime          @map("data_inicio") @db.Date
  dataFim              DateTime?         @map("data_fim") @db.Date
  reavaliacaoId        String?           @unique @map("reavaliacao_id") @db.Uuid
  patrimonioId         String            @map("patrimonio_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)

  reavaliacao  ReavaliacaoPatrimonio?  @relation(fields: [reavaliacaoId], references: [id])
  reavaliacoesAnteriores ReavaliacaoPatrimonio[] @relation("ReavaliacaoParametroAnterior")
  patrimonio   Patrimonio              @relation(fields: [patrimonioId], references: [id])
  depreciacoes DepreciacaoPatrimonio[]

  @@unique([patrimonioId], map: "parametros_depreciacao_patrimonio_vigente_uidx", where: { dataFim: null })
  @@map("parametros_depreciacao")
}

model DepreciacaoPatrimonio {
  id                     String   @id @default(uuid()) @db.Uuid
  dataDepreciacao        DateTime @map("data_depreciacao") @db.Timestamp(6)
  dataCompetencia        DateTime @map("data_competencia") @db.Date
  valorContabilAnterior  Decimal  @map("valor_contabil_anterior") @db.Decimal(19, 7)
  valorDepreciado        Decimal  @map("valor_depreciado") @db.Decimal(19, 7)
  valorContabilNovo      Decimal  @map("valor_contabil_novo") @db.Decimal(19, 7)
  observacao             String?  @db.Text
  patrimonioId           String   @map("patrimonio_id") @db.Uuid
  parametroDepreciacaoId String   @map("parametro_depreciacao_id") @db.Uuid
  comissaoId             String   @map("comissao_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdById String   @map("created_by_id") @db.Uuid

  patrimonio           Patrimonio           @relation(fields: [patrimonioId], references: [id])
  parametroDepreciacao ParametroDepreciacao @relation(fields: [parametroDepreciacaoId], references: [id])
  comissao             Comissao             @relation(fields: [comissaoId], references: [id])
  createdBy            Usuario              @relation(fields: [createdById], references: [id])

  @@unique([patrimonioId, parametroDepreciacaoId, dataCompetencia])
  @@index([comissaoId], map: "depreciacoes_patrimoniais_comissao_id_idx")
  @@map("depreciacoes_patrimoniais")
}

model ReavaliacaoPatrimonio {
  id                            String   @id @default(uuid()) @db.Uuid
  dataReavaliacao               DateTime @map("data_reavaliacao") @db.Timestamp(6)
  dataReferencia                DateTime? @map("data_referencia") @db.Date
  valorLiquidoAnterior          Decimal  @map("valor_liquido_anterior") @db.Decimal(19, 7)
  valorBrutoAnterior            Decimal? @map("valor_bruto_anterior") @db.Decimal(19, 7)
  depreciacaoAcumuladaAnterior  Decimal? @map("depreciacao_acumulada_anterior") @db.Decimal(19, 7)
  valorBaseAnterior             Decimal? @map("valor_base_anterior") @db.Decimal(19, 7)
  percentualResidualAnterior    Decimal? @map("percentual_residual_anterior") @db.Decimal(5, 2)
  vidaUtilInicialAnteriorMeses  Int? @map("vida_util_inicial_anterior_meses")
  quantidadeDepreciacoesAnteriores Int? @map("quantidade_depreciacoes_anteriores")
  dataInicioAnterior            DateTime? @map("data_inicio_anterior") @db.Date
  parametroAnteriorId           String? @map("parametro_anterior_id") @db.Uuid
  valorReavaliado               Decimal  @map("valor_reavaliado") @db.Decimal(19, 7)
  valorBaseNovo                 Decimal? @map("valor_base_novo") @db.Decimal(19, 7)
  percentualResidualNovo        Decimal? @map("percentual_residual_novo") @db.Decimal(5, 2)
  valorResidualAnterior         Decimal? @map("valor_residual_anterior") @db.Decimal(19, 7)
  valorResidualNovo             Decimal  @map("valor_residual_novo") @db.Decimal(19, 7)
  vidaUtilRestanteAnteriorMeses Int?     @map("vida_util_restante_anterior_meses")
  vidaUtilNovaMeses             Int      @map("vida_util_nova_meses")
  laudoTecnico                  String?  @map("laudo_tecnico") @db.Text
  observacao                    String?  @db.Text
  numeroPatrimonioSnapshot      String? @map("numero_patrimonio_snapshot") @db.VarChar(50)
  descricaoPatrimonioSnapshot   String? @map("descricao_patrimonio_snapshot") @db.VarChar(1000)
  nomeComissaoSnapshot          String? @map("nome_comissao_snapshot") @db.VarChar(150)
  nomeAutorSnapshot             String? @map("nome_autor_snapshot") @db.VarChar(150)
  patrimonioId                  String   @map("patrimonio_id") @db.Uuid
  comissaoId                    String   @map("comissao_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdById String   @map("created_by_id") @db.Uuid

  patrimonio           Patrimonio            @relation(fields: [patrimonioId], references: [id])
  comissao             Comissao              @relation(fields: [comissaoId], references: [id])
  createdBy            Usuario               @relation(fields: [createdById], references: [id])
  parametroDepreciacao ParametroDepreciacao?
  parametroAnterior    ParametroDepreciacao? @relation("ReavaliacaoParametroAnterior", fields: [parametroAnteriorId], references: [id], onDelete: Restrict)

  @@index([comissaoId], map: "reavaliacoes_patrimoniais_comissao_id_idx")
  @@index([dataReferencia(sort: Desc), dataReavaliacao(sort: Desc), id(sort: Desc)], map: "reavaliacoes_data_id_idx")
  @@index([patrimonioId, dataReferencia(sort: Desc), id(sort: Desc)], map: "reavaliacoes_patrimonio_data_idx")
  @@map("reavaliacoes_patrimoniais")
}

// Registro técnico do pedido atômico; cada bem continua com histórico próprio.
model IdempotenciaReavaliacao {
  usuarioId String @map("usuario_id") @db.Uuid
  chave String @db.Uuid
  payloadHash String @map("payload_hash") @db.Char(64)
  resultado Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@id([usuarioId, chave])
  @@map("idempotencias_reavaliacao")
}

// Registro técnico de um pedido confirmado; não representa um lote patrimonial.
model IdempotenciaMovimentacao {
  usuarioId String @map("usuario_id") @db.Uuid
  chave String @db.Uuid
  payloadHash String @map("payload_hash") @db.Char(64)
  resultado Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@id([usuarioId, chave])
  @@map("idempotencias_movimentacao")
}
