# Produção
APP_ENV=production
NODE_ENV=production
APP_NAME=sipat
APP_VERSION=0.1.0
LOG_LEVEL=info

WEB_PORT=3000
API_PORT=3001
WEB_PUBLISHED_PORT=3200
API_PUBLISHED_PORT=3201
BIND_ADDRESS=127.0.0.1
WEB_URL=http://localhost:3200
API_INTERNAL_URL=http://api:3001
CORS_ORIGINS=http://localhost:3200
NEXT_PUBLIC_APP_NAME=SIPAT
NEXT_PUBLIC_APP_ENV=production

POSTGRES_USER=sipat_production
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=sipat_production
DATABASE_URL=postgresql://sipat_production:replace-with-a-strong-password@db:5432/sipat_production?schema=public

COMPOSE_PROJECT_NAME=sipat-production
IMAGE_TAG=production
