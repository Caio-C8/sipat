# Produção
APP_ENV=production
NODE_ENV=production
APP_NAME=sipat
APP_VERSION=0.1.0
LOG_LEVEL=info

WEB_PORT=3000
API_PORT=3001
UPLOADS_HOST_PATH=C:/SIPAT/data/uploads
UPLOADS_ROOT_PATH=C:/SIPAT/data/uploads
WEB_PUBLISHED_PORT=3200
API_PUBLISHED_PORT=3201
MOBILE_WEB_PUBLISHED_PORT=3281
BIND_ADDRESS=127.0.0.1
WEB_URL=http://localhost:3200
MOBILE_WEB_URL=http://localhost:3281
API_INTERNAL_URL=http://api:3001
CORS_ORIGINS=http://localhost:3200,http://localhost:3281
AUTH_RATE_LIMIT_HMAC_SECRET=<gere-32-bytes-em-base64url-sem-padding>
AUTH_ARGON2_MAX_CONCURRENCY=4
AUTH_ARGON2_MAX_QUEUE=20
AUTH_PASSWORD_RESET_ENABLED=false
AUTH_PASSWORD_RESET_URL=
AUTH_EMAIL_MAX_CONCURRENCY=2
AUTH_EMAIL_MAX_QUEUE=100
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NEXT_PUBLIC_APP_NAME=SIPAT
NEXT_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_NAME=SIPAT
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_URL=http://localhost:3201
EXPO_PUBLIC_API_PORT=3001

POSTGRES_USER=sipat_production
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=sipat_production
DATABASE_URL=postgresql://sipat_production:replace-with-a-strong-password@db:5432/sipat_production?schema=public

COMPOSE_PROJECT_NAME=sipat-production
IMAGE_TAG=production
